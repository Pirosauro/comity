{
  "meta": {
    "name": "comity-jsdoc-standards",
    "version": "1.0.0",
    "scope": "documentation",
    "authoritative": true
  },

  "general": {
    "required_for": ["public classes", "public functions", "public interfaces", "public types"],
    "forbidden_for": ["internal implementations", "private methods", "private fields"]
  },

  "style": {
    "comment_type": {
      "single_line_allowed": true,
      "multiline_required_when": ["has params", "has return value", "throws", "public api"]
    }
  },

  "layout": {
    "structure": [
      "description",
      "blank_line",
      "params_block",
      "returns_block",
      "throws_block",
      "type_params_block",
      "blank_line",
      "remarks",
      "blank_line",
      "example",
      "blank_line",
      "comity_tags"
    ],

    "block_definitions": {
      "params_block": ["@param"],
      "returns_block": ["@returns"],
      "throws_block": ["@throws"],
      "type_params_block": ["@typeParam"],
      "comity_tags": ["@comity"]
    },

    "rules": [
      "Blocks MUST appear in declared order",
      "@comity tag MUST be last",
      "Blocks MUST be grouped without interleaving"
    ]
  },

  "optional_tags_policy": {
    "@remarks": {
      "allowed": true,
      "required_when": ["non-obvious behavior"]
    },
    "@example": {
      "allowed": true,
      "required_when": ["public api with usage ambiguity"]
    }
  },

  "consistency": {
    "module_level": {
      "rule": "Modules SHOULD be consistent internally",
      "note": "If a module uses @example everywhere, missing examples are violations"
    }
  },

  "severity_mapping": {
    "missing_jsdoc_on_public_api": "IMPORTANT",
    "wrong_tag_order": "NOTE",
    "missing_required_block": "IMPORTANT",
    "comity_tag_not_last": "NOTE"
  }
}
