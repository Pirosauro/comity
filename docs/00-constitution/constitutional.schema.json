{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Constitutional Axioms Front Matter Schema",
  "type": "object",
  "required": [
    "id",
    "status",
    "version",
    "owner",
    "enforcement",
    "last_reviewed",
    "next_review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "const": "constitutional-axioms",
      "description": "Fixed identifier for the constitutional document"
    },
    "status": {
      "type": "string",
      "const": "authoritative",
      "description": "Constitution is always authoritative"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.0\\.0$",
      "description": "Major-only semantic versioning"
    },
    "owner": {
      "type": "string",
      "const": "@architecture-council",
      "description": "Constitution owner is fixed"
    },
    "enforcement": {
      "type": "string",
      "const": "block",
      "description": "Constitutional violations always block"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "next_review": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false,
  "not": {
    "anyOf": [
      { "required": ["supersedes"] },
      { "required": ["date"] },
      { "required": ["deprecated"] }
    ]
  }
}
