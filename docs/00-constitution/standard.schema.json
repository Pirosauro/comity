{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Authoritative Standard Front Matter Schema",
  "type": "object",
  "required": [
    "id",
    "status",
    "version",
    "owner",
    "enforcement",
    "last_reviewed",
    "next_review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9\\-]+$",
      "description": "Unique identifier for the standard (kebab-case)"
    },
    "status": {
      "type": "string",
      "enum": ["authoritative", "deprecated", "superseded"],
      "description": "Lifecycle status of the standard"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the standard"
    },
    "owner": {
      "type": "string",
      "pattern": "^@[a-z0-9\\-_/]+$",
      "description": "Owning team"
    },
    "enforcement": {
      "type": "string",
      "enum": ["block", "warn"],
      "description": "Enforcement level for violations"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date",
      "description": "Date of last review"
    },
    "next_review": {
      "type": "string",
      "format": "date",
      "description": "Date of next scheduled review"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9\\-]+$"
      },
      "description": "IDs of standards superseded by this one"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["deprecated", "superseded"] } }
      },
      "then": {
        "required": ["supersedes"]
      }
    }
  ],
  "not": {
    "anyOf": [{ "required": ["date"] }, { "required": ["enforcement", "none"] }]
  }
}
