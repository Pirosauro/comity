{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/docs/00-constitution/registry.schema.json",
  "title": "Comity Documentation Registry Schema",
  "description": "Schema for validating the authoritative documentation registry",
  "type": "object",
  "required": ["version", "last_updated", "documents"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./registry.schema.json",
      "description": "Reference to this schema"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the registry schema"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "Date when registry was last updated (YYYY-MM-DD)"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      },
      "minItems": 1,
      "description": "List of all registered documents",
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "id",
        "path",
        "level",
        "owner",
        "enforcement",
        "registered",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9\\-]+$",
          "description": "Unique document identifier (kebab-case)"
        },
        "path": {
          "type": "string",
          "format": "uri-reference",
          "description": "Path to document from repository root"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "description": "Authority level (0=Constitution, 7=Archive)"
        },
        "owner": {
          "type": "string",
          "pattern": "^@[a-z0-9\\-_/]+$",
          "description": "Owning team or council"
        },
        "enforcement": {
          "type": "string",
          "enum": ["block", "warn", "none"],
          "description": "Enforcement level for violations"
        },
        "registered": {
          "type": "string",
          "format": "date",
          "description": "Date document was registered (YYYY-MM-DD)"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Document version (semantic)"
        },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated", "superseded"],
          "default": "active",
          "description": "Document lifecycle status"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9\\-]+$"
          },
          "uniqueItems": true,
          "description": "IDs of documents superseded by this one"
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9\\-]+$"
          },
          "uniqueItems": true,
          "description": "IDs of documents that supersede this one"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "level": { "const": 7 }
            }
          },
          "then": {
            "properties": {
              "enforcement": { "const": "none" },
              "status": { "enum": ["deprecated", "superseded"] }
            },
            "required": ["status"]
          }
        },
        {
          "if": {
            "properties": {
              "status": { "enum": ["deprecated", "superseded"] }
            }
          },
          "then": {
            "properties": {
              "enforcement": { "const": "none" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": { "enum": [0, 1, 2, 3, 4] }
            }
          },
          "then": {
            "properties": {
              "enforcement": { "enum": ["block", "warn"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": { "enum": [5, 6] }
            }
          },
          "then": {
            "properties": {
              "enforcement": { "enum": ["none"] }
            }
          }
        }
      ]
    }
  }
}
