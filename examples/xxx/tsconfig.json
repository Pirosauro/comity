{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node", "vite/client"]
  },
  "exclude": ["**/*.test.ts"],
  "include": ["**/*.ts", "**/*.tsx"]
}
