{
  "type": "module",
  "scripts": {
    "dev": "vite -c src/config/vite.ts",
    "build": "vite build -c src/config/vite.ts",
    "preview": "wrangler pages dev dist",
    "deploy": "$npm_execpath run build && wrangler pages deploy dist --branch production",
    "db:generate": "drizzle-kit generate --config=./src/config/drizzle.ts",
    "db:push": "drizzle-kit push --config=./src/config/drizzle.ts"
  },
  "dependencies": {
    "@comity/application": "workspace:*",
    "@comity/auth": "workspace:*",
    "@comity/graphql": "workspace:*",
    "@comity/hydration": "workspace:*",
    "@comity/logger": "workspace:*",
    "@comity/react": "workspace:*",
    "@comity/slug": "workspace:*",
    "@comity/workspace": "workspace:*",
    "hono": "^4.11.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.2.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.8.0",
    "@hono/vite-dev-server": "^0.23.0",
    "@types/node": "^24.10.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3",
    "wrangler": "^4.54.0"
  }
}
