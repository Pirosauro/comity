{
  "name": "@comity/hydration",
  "version": "1.0.0",
  "description": "Hydration module for server-rendered applications with Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "hydration",
    "ssr",
    "server-side rendering",
    "rendering",
    "islands",
    "composability",
    "react",
    "preact",
    "hono",
    "framework",
    "typescript",
    "javascript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/types/client/index.d.ts",
        "default": "./dist/esm/client/index.js"
      },
      "require": {
        "types": "./dist/types/client/index.d.ts",
        "default": "./dist/cjs/client/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/esm/setup/index.js"
      },
      "require": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/cjs/setup/index.js"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/types/vite/index.d.ts",
        "default": "./dist/esm/vite/index.js"
      },
      "require": {
        "types": "./dist/types/vite/index.d.ts",
        "default": "./dist/cjs/vite/index.js"
      }
    },
    "./types": {
      "types": "./module.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/types/client/index.d.ts"
      ],
      "setup": [
        "./dist/types/setup/index.d.ts"
      ],
      "vite": [
        "./dist/types/vite/index.d.ts"
      ],
      "types": [
        "./module.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/application": "workspace:*",
    "@comity/core": "workspace:*",
    "@comity/logger": "workspace:*",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.7",
    "typescript": "^5.9.3"
  }
}
