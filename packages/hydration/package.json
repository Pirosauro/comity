{
  "name": "@comity/hydration",
  "version": "1.0.0",
  "description": "Hydration module for server-rendered applications with the Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "hydration",
    "islands",
    "composability",
    "framework",
    "typescript",
    "javascript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/types/client/index.d.ts",
        "default": "./dist/esm/client/index.js"
      },
      "require": {
        "types": "./dist/types/client/index.d.ts",
        "default": "./dist/cjs/client/index.js"
      }
    },
    "./client/strategies": {
      "import": {
        "types": "./dist/types/client/strategies/index.d.ts",
        "default": "./dist/esm/client/strategies/index.js"
      },
      "require": {
        "types": "./dist/types/client/strategies/index.d.ts",
        "default": "./dist/cjs/client/strategies/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/types/server/index.d.ts",
        "default": "./dist/esm/server/index.js"
      },
      "require": {
        "types": "./dist/types/server/index.d.ts",
        "default": "./dist/cjs/server/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/esm/setup/index.js"
      },
      "require": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/cjs/setup/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/types/client/index.d.ts"
      ],
      "client/strategies": [
        "./dist/types/client/strategies/index.d.ts"
      ],
      "server": [
        "./dist/types/server/index.d.ts"
      ],
      "setup": [
        "./dist/types/setup/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/primitives": "workspace:*",
    "@comity/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3"
  }
}
