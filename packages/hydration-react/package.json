{
  "name": "@comity/hydration-react",
  "version": "0.9.0",
  "description": "Hydration module for server-rendered applications with Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "hydration",
    "rendering",
    "islands",
    "composability",
    "react",
    "framework",
    "typescript",
    "javascript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --ext .ts src"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/esm/setup/index.js"
      },
      "require": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/cjs/setup/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "setup": [
        "./dist/types/setup/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/hydration": "workspace:*",
    "@comity/primitives": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
