{
  "name": "@comity/hydration-react",
  "version": "1.0.0",
  "description": "Hydration module for server-rendered applications with Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "hydration",
    "ssr",
    "server-side rendering",
    "rendering",
    "islands",
    "composability",
    "react",
    "preact",
    "hono",
    "framework",
    "typescript",
    "javascript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/types/client/index.d.ts",
        "default": "./dist/esm/client/index.js"
      },
      "require": {
        "types": "./dist/types/client/index.d.ts",
        "default": "./dist/cjs/client/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/types/core/index.d.ts",
        "default": "./dist/esm/core/index.js"
      },
      "require": {
        "types": "./dist/types/core/index.d.ts",
        "default": "./dist/cjs/core/index.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/esm/errors/index.js"
      },
      "require": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/cjs/errors/index.js"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/types/runtime/index.d.ts",
        "default": "./dist/esm/runtime/index.js"
      },
      "require": {
        "types": "./dist/types/runtime/index.d.ts",
        "default": "./dist/cjs/runtime/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/types/server/index.d.ts",
        "default": "./dist/esm/server/index.js"
      },
      "require": {
        "types": "./dist/types/server/index.d.ts",
        "default": "./dist/cjs/server/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/esm/setup/index.js"
      },
      "require": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/cjs/setup/index.js"
      }
    },
    "./types": {
      "types": "./module.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/types/client/index.d.ts"
      ],
      "core": [
        "./dist/types/core/index.d.ts"
      ],
      "errors": [
        "./dist/types/errors/index.d.ts"
      ],
      "runtime": [
        "./dist/types/runtime/index.d.ts"
      ],
      "server": [
        "./dist/types/server/index.d.ts"
      ],
      "setup": [
        "./dist/types/setup/index.d.ts"
      ],
      "types": [
        "./module.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
