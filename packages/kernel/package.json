{
  "name": "@comity/kernel",
  "version": "0.9.0",
  "description": "Runtime orchestrator providing lifecycle, DI, and shared services for Comity",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "comity",
    "comityjs",
    "framework",
    "kernel",
    "runtime",
    "orchestrator",
    "lifecycle",
    "dependency-injection"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/types/hooks/index.d.ts",
        "default": "./dist/esm/hooks/index.js"
      },
      "require": {
        "types": "./dist/types/hooks/index.d.ts",
        "default": "./dist/cjs/hooks/index.js"
      }
    },
    "./error": {
      "import": {
        "types": "./dist/types/error/index.d.ts",
        "default": "./dist/esm/error/index.js"
      },
      "require": {
        "types": "./dist/types/error/index.d.ts",
        "default": "./dist/cjs/error/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "hooks": [
        "./dist/types/hooks/index.d.ts"
      ],
      "error": [
        "./dist/types/error/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/primitives": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3"
  }
}
