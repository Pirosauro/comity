{
  "name": "@comity/primitives",
  "version": "0.9.0",
  "description": "Foundational primitives shared across Comity packages (events, results, cancellation, composition).",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": false,
  "keywords": [
    "comity",
    "primitives",
    "infrastructure",
    "events",
    "result",
    "abort",
    "composition"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --ext .ts src"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./di": {
      "import": {
        "types": "./dist/types/di/index.d.ts",
        "default": "./dist/esm/di/index.js"
      },
      "require": {
        "types": "./dist/types/di/index.d.ts",
        "default": "./dist/cjs/di/index.js"
      }
    },
    "./error": {
      "import": {
        "types": "./dist/types/error/index.d.ts",
        "default": "./dist/esm/error/index.js"
      },
      "require": {
        "types": "./dist/types/error/index.d.ts",
        "default": "./dist/cjs/error/index.js"
      }
    },
    "./lifecycle": {
      "import": {
        "types": "./dist/types/lifecycle/index.d.ts",
        "default": "./dist/esm/lifecycle/index.js"
      },
      "require": {
        "types": "./dist/types/lifecycle/index.d.ts",
        "default": "./dist/cjs/lifecycle/index.js"
      }
    },
    "./result": {
      "import": {
        "types": "./dist/types/result/index.d.ts",
        "default": "./dist/esm/result/index.js"
      },
      "require": {
        "types": "./dist/types/result/index.d.ts",
        "default": "./dist/cjs/result/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "di": [
        "./dist/types/di/index.d.ts"
      ],
      "error": [
        "./dist/types/error/index.d.ts"
      ],
      "lifecycle": [
        "./dist/types/lifecycle/index.d.ts"
      ],
      "result": [
        "./dist/types/result/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}
