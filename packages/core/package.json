{
  "name": "@comity/core",
  "version": "1.0.0",
  "description": "Core framework for building modular applications",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "comity",
    "comityjs",
    "framework",
    "modular",
    "web",
    "typescript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./di": {
      "import": {
        "types": "./dist/types/di/index.d.ts",
        "default": "./dist/esm/di/index.js"
      },
      "require": {
        "types": "./dist/types/di/index.d.ts",
        "default": "./dist/cjs/di/index.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/esm/errors/index.js"
      },
      "require": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/cjs/errors/index.js"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/types/events/index.d.ts",
        "default": "./dist/esm/events/index.js"
      },
      "require": {
        "types": "./dist/types/events/index.d.ts",
        "default": "./dist/cjs/events/index.js"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/types/hooks/index.d.ts",
        "default": "./dist/esm/hooks/index.js"
      },
      "require": {
        "types": "./dist/types/hooks/index.d.ts",
        "default": "./dist/cjs/hooks/index.js"
      }
    },
    "./lazy": {
      "import": {
        "types": "./dist/types/lazy/index.d.ts",
        "default": "./dist/esm/lazy/index.js"
      },
      "require": {
        "types": "./dist/types/lazy/index.d.ts",
        "default": "./dist/cjs/lazy/index.js"
      }
    },
    "./result": {
      "import": {
        "types": "./dist/types/result/index.d.ts",
        "default": "./dist/esm/result/index.js"
      },
      "require": {
        "types": "./dist/types/result/index.d.ts",
        "default": "./dist/cjs/result/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "di": [
        "./dist/types/di/index.d.ts"
      ],
      "errors": [
        "./dist/types/errors/index.d.ts"
      ],
      "events": [
        "./dist/types/events/index.d.ts"
      ],
      "hooks": [
        "./dist/types/hooks/index.d.ts"
      ],
      "lazy": [
        "./dist/types/lazy/index.d.ts"
      ],
      "result": [
        "./dist/types/result/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^24.10.9",
    "typescript": "^5.9.3"
  }
}
