{
  "name": "@comity/graphql-client",
  "version": "0.9.0",
  "description": "GraphQL client module for Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "graphql",
    "typescript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./error": {
      "import": {
        "types": "./dist/types/error/index.d.ts",
        "default": "./dist/esm/error/index.js"
      },
      "require": {
        "types": "./dist/types/error/index.d.ts",
        "default": "./dist/cjs/error/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/esm/setup/index.js"
      },
      "require": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/cjs/setup/index.js"
      }
    },
    "./transports": {
      "import": {
        "types": "./dist/types/transports/index.d.ts",
        "default": "./dist/esm/transports/index.js"
      },
      "require": {
        "types": "./dist/types/transports/index.d.ts",
        "default": "./dist/cjs/transports/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "error": [
        "./dist/types/error/index.d.ts"
      ],
      "setup": [
        "./dist/types/setup/index.d.ts"
      ],
      "transports": [
        "./dist/types/transports/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/composition": "workspace:*",
    "@comity/kernel": "workspace:*",
    "@comity/primitives": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "typescript": "^5.9.3"
  }
}
