{
  "name": "@comity/graphql",
  "version": "1.0.0",
  "description": "GraphQL module for Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "api",
    "graphql",
    "typescript",
    "framework"
  ],
  "scripts": {
    "build": "tsc",
    "prepublish": "tsc",
    "dev": "tsc -b --watch",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "./dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@comity/application": "workspace:*",
    "@comity/core": "workspace:*",
    "@comity/logger": "workspace:*",
    "@envelop/core": "^5.4.0",
    "graphql": "^16.12.0",
    "hono": "^4.10.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "hono": ">=4.9.0 <5.0.0"
  }
}
