{
  "name": "@comity/drizzle",
  "version": "1.0.0",
  "description": "Drizzle ORM module for Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "database",
    "drizzle",
    "drizzle-orm",
    "orm",
    "sql",
    "typescript",
    "framework"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./adapters/d1": {
      "import": {
        "types": "./dist/types/adapters/d1/index.d.ts",
        "default": "./dist/esm/adapters/d1/index.js"
      },
      "require": {
        "types": "./dist/types/adapters/d1/index.d.ts",
        "default": "./dist/cjs/adapters/d1/index.js"
      }
    },
    "./adapters/postgres": {
      "import": {
        "types": "./dist/types/adapters/postgres/index.d.ts",
        "default": "./dist/esm/adapters/postgres/index.js"
      },
      "require": {
        "types": "./dist/types/adapters/postgres/index.d.ts",
        "default": "./dist/cjs/adapters/postgres/index.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/esm/errors/index.js"
      },
      "require": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/cjs/errors/index.js"
      }
    },
    "./helpers": {
      "import": {
        "types": "./dist/types/helpers/index.d.ts",
        "default": "./dist/esm/helpers/index.js"
      },
      "require": {
        "types": "./dist/types/helpers/index.d.ts",
        "default": "./dist/cjs/helpers/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/esm/setup/index.js"
      },
      "require": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/cjs/setup/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "adapters/d1": [
        "./dist/types/adapters/d1/index.d.ts"
      ],
      "adapters/postgres": [
        "./dist/types/adapters/postgres/index.d.ts"
      ],
      "errors": [
        "./dist/types/errors/index.d.ts"
      ],
      "helpers": [
        "./dist/types/helpers/index.d.ts"
      ],
      "setup": [
        "./dist/types/setup/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/cli": "workspace:*",
    "@comity/core": "workspace:*",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.7",
    "typescript": "^5.9.3"
  }
}
