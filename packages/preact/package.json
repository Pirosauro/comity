{
  "name": "@comity/preact",
  "version": "1.0.0",
  "description": "Preact module for server-rendered applications with Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "hydration",
    "ssr",
    "server-side rendering",
    "rendering",
    "islands",
    "composability",
    "preact",
    "hono",
    "framework",
    "typescript",
    "javascript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/esm/setup/index.js"
      },
      "require": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/cjs/setup/index.js"
      }
    },
    "./streaming": {
      "import": {
        "types": "./dist/types/streaming/index.d.ts",
        "default": "./dist/esm/streaming/index.js",
        "node": "./dist/esm/streaming/index.node.js"
      },
      "require": {
        "types": "./dist/types/streaming/index.d.ts",
        "default": "./dist/cjs/streaming/index.js",
        "node": "./dist/cjs/streaming/index.node.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "setup": [
        "./dist/types/setup/index.d.ts"
      ],
      "streaming": [
        "./dist/types/streaming/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/application": "workspace:*",
    "@comity/hydration": "workspace:*",
    "@comity/logger": "workspace:*",
    "hono": "^4.11.3",
    "preact": "^10.28.1",
    "preact-render-to-string": "^6.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "typescript": "^5.9.3"
  }
}
