{
  "name": "@comity/user",
  "version": "1.0.0",
  "description": "User module for Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "user",
    "acl",
    "permissions",
    "roles",
    "typescript",
    "framework"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./database": {
      "import": {
        "types": "./dist/types/database/index.d.ts",
        "default": "./dist/esm/database/index.js"
      },
      "require": {
        "types": "./dist/types/database/index.d.ts",
        "default": "./dist/cjs/database/index.js"
      }
    },
    "./repositories": {
      "import": {
        "types": "./dist/types/repositories/index.d.ts",
        "default": "./dist/esm/repositories/index.js"
      },
      "require": {
        "types": "./dist/types/repositories/index.d.ts",
        "default": "./dist/cjs/repositories/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup.d.ts",
        "default": "./dist/esm/setup.js"
      },
      "require": {
        "types": "./dist/types/setup.d.ts",
        "default": "./dist/cjs/setup.js"
      }
    },
    "./use-cases": {
      "import": {
        "types": "./dist/types/use-cases/index.d.ts",
        "default": "./dist/esm/use-cases/index.js"
      },
      "require": {
        "types": "./dist/types/use-cases/index.d.ts",
        "default": "./dist/cjs/use-cases/index.js"
      }
    },
    "./validation": {
      "import": {
        "types": "./dist/types/validation/index.d.ts",
        "default": "./dist/esm/validation/index.js"
      },
      "require": {
        "types": "./dist/types/validation/index.d.ts",
        "default": "./dist/cjs/validation/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "database": [
        "./dist/types/database/index.d.ts"
      ],
      "repositories": [
        "./dist/types/repositories/index.d.ts"
      ],
      "setup": [
        "./dist/types/setup.d.ts"
      ],
      "use-cases": [
        "./dist/types/use-cases/index.d.ts"
      ],
      "validation": [
        "./dist/types/validation/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@casl/ability": "^6.7.5",
    "@comity/application": "workspace:*",
    "@comity/auth": "workspace:*",
    "@comity/core": "workspace:*",
    "@comity/logger": "workspace:*",
    "@comity/postgres": "workspace:*",
    "@comity/workspace": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.7",
    "typescript": "^5.9.3"
  }
}
