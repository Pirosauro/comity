{
  "name": "@comity/application",
  "version": "1.0.0",
  "description": "General web application module for Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "framework",
    "application",
    "modular",
    "vite",
    "vite-plugin",
    "ssr",
    "dev-server",
    "typescript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/types/cli/index.d.ts",
        "default": "./dist/esm/cli/index.js"
      },
      "require": {
        "types": "./dist/types/cli/index.d.ts",
        "default": "./dist/cjs/cli/index.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/esm/errors/index.js"
      },
      "require": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/cjs/errors/index.js"
      }
    },
    "./factories": {
      "import": {
        "types": "./dist/types/factories/index.d.ts",
        "default": "./dist/esm/factories/index.js"
      },
      "require": {
        "types": "./dist/types/factories/index.d.ts",
        "default": "./dist/cjs/factories/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/esm/setup/index.js"
      },
      "require": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/cjs/setup/index.js"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/types/vite/index.d.ts",
        "default": "./dist/esm/vite/index.js"
      },
      "require": {
        "types": "./dist/types/vite/index.d.ts",
        "default": "./dist/cjs/vite/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "cli": [
        "./dist/types/cli/index.d.ts"
      ],
      "errors": [
        "./dist/types/errors/index.d.ts"
      ],
      "factories": [
        "./dist/types/factories/index.d.ts"
      ],
      "setup": [
        "./dist/types/setup/index.d.ts"
      ],
      "vite": [
        "./dist/types/vite/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/cli": "workspace:*",
    "@comity/core": "workspace:*",
    "hono": "^4.11.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "typescript": "^5.9.3"
  }
}
