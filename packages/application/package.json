{
  "name": "@comity/application",
  "version": "1.0.0",
  "description": "General web application module for Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "framework",
    "application",
    "modular",
    "vite",
    "vite-plugin",
    "ssr",
    "dev-server",
    "typescript"
  ],
  "scripts": {
    "build": "tsc",
    "prepublish": "tsc",
    "dev": "tsc -b --watch",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "./dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/cli": "workspace:*",
    "@comity/core": "workspace:*",
    "hono": "^4.10.8",
    "vite": "^7.2.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "typescript": "^5.9.3"
  }
}
