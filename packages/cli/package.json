{
  "name": "@comity/cli",
  "version": "1.0.0",
  "description": "Command Line Interface module for Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "cli",
    "command-line",
    "commander",
    "typescript",
    "framework"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "bin": {
    "default": "./dist/cjs/bin/index.js"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": true,
  "dependencies": {
    "commander": "^14.0.2",
    "pino": "^10.1.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "typescript": "^5.9.3"
  }
}
