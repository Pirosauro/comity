{
  "name": "@comity/postgres",
  "version": "1.0.0",
  "description": "Database module for Comity framework with Drizzle ORM and PostgreSQL",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "database",
    "drizzle",
    "drizzle-orm",
    "postgresql",
    "postgres",
    "pg",
    "orm",
    "sql",
    "typescript",
    "middleware",
    "hono",
    "framework"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/types/cli/index.d.ts",
        "default": "./dist/esm/cli/index.js"
      },
      "require": {
        "types": "./dist/types/cli/index.d.ts",
        "default": "./dist/cjs/cli/index.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/esm/errors/index.js"
      },
      "require": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/cjs/errors/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/esm/setup/index.js"
      },
      "require": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/cjs/setup/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "cli": [
        "./dist/types/cli/index.d.ts"
      ],
      "errors": [
        "./dist/types/errors/index.d.ts"
      ],
      "setup": [
        "./dist/types/setup/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/application": "workspace:*",
    "@comity/cli": "workspace:*",
    "@comity/core": "workspace:*",
    "@comity/logger": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.7",
    "@types/pg": "^8.16.0",
    "typescript": "^5.9.3"
  }
}
