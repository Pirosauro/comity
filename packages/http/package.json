{
  "name": "@comity/http",
  "version": "1.0.0",
  "description": "HTTP module for Comity framework applications",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "framework",
    "http",
    "typescript",
    "hono",
    "react"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "vitest run --coverage"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./adapters/hono": {
      "import": {
        "types": "./dist/types/adapters/hono/index.d.ts",
        "default": "./dist/esm/adapters/hono/index.js"
      },
      "require": {
        "types": "./dist/types/adapters/hono/index.d.ts",
        "default": "./dist/cjs/adapters/hono/index.js"
      }
    },
    "./renderers": {
      "import": {
        "types": "./dist/types/renderers/index.d.ts",
        "default": "./dist/esm/renderers/index.js"
      },
      "require": {
        "types": "./dist/types/renderers/index.d.ts",
        "default": "./dist/cjs/renderers/index.js"
      }
    },
    "./renderers/react": {
      "node": {
        "import": {
          "types": "./dist/types/renderers/react/node.d.ts",
          "default": "./dist/esm/renderers/react/node.js"
        },
        "require": {
          "types": "./dist/types/renderers/react/node.d.ts",
          "default": "./dist/cjs/renderers/react/node.js"
        }
      },
      "default": {
        "import": {
          "types": "./dist/types/renderers/react/index.d.ts",
          "default": "./dist/esm/renderers/react/index.js"
        },
        "require": {
          "types": "./dist/types/renderers/react/index.d.ts",
          "default": "./dist/cjs/renderers/react/index.js"
        }
      }
    },
    "./response": {
      "import": {
        "types": "./dist/types/response/index.d.ts",
        "default": "./dist/esm/response/index.js"
      },
      "require": {
        "types": "./dist/types/response/index.d.ts",
        "default": "./dist/cjs/response/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/esm/setup/index.js"
      },
      "require": {
        "types": "./dist/types/setup/index.d.ts",
        "default": "./dist/cjs/setup/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "adapters/hono": [
        "./dist/types/adapters/hono/index.d.ts"
      ],
      "renderers": [
        "./dist/types/renderers/index.d.ts"
      ],
      "renderers/react": [
        "./dist/types/renderers/react/index.d.ts",
        "./dist/types/renderers/react/node.d.ts"
      ],
      "response": [
        "./dist/types/response/index.d.ts"
      ],
      "setup": [
        "./dist/types/setup/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/core": "workspace:*",
    "@comity/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "hono": "^4.11.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "hono": "^4.11.4",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
