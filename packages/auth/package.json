{
  "name": "@comity/auth",
  "version": "1.0.0",
  "description": "Authentication module with JWT token handling using JOSE for Comity framework",
  "type": "module",
  "author": "Filippo Bovo <hello@filippobovo.com>",
  "license": "MIT",
  "homepage": "https://github.com/comityjs/framework#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/framework.git"
  },
  "bugs": {
    "url": "https://github.com/comityjs/framework/issues"
  },
  "keywords": [
    "comity",
    "comityjs",
    "auth",
    "authentication",
    "jwt",
    "jose",
    "token",
    "refresh-token",
    "security",
    "session",
    "typescript"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepublish": "node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch"
  },
  "files": [
    "./dist",
    "!./dist/**/*.map"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/esm/errors/index.js"
      },
      "require": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/cjs/errors/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/types/setup.d.ts",
        "default": "./dist/esm/setup.js"
      },
      "require": {
        "types": "./dist/types/setup.d.ts",
        "default": "./dist/cjs/setup.js"
      }
    },
    "./adapters/jose": {
      "import": {
        "types": "./dist/types/adapters/jose/index.d.ts",
        "default": "./dist/esm/adapters/jose/index.js"
      },
      "require": {
        "types": "./dist/types/adapters/jose/index.d.ts",
        "default": "./dist/cjs/adapters/jose/index.js"
      }
    },
    "./adapters/jwt": {
      "import": {
        "types": "./dist/types/adapters/jwt/index.d.ts",
        "default": "./dist/esm/adapters/jwt/index.js"
      },
      "require": {
        "types": "./dist/types/adapters/jwt/index.d.ts",
        "default": "./dist/cjs/adapters/jwt/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "adapters/jose": [
        "./dist/types/adapters/jose/index.d.ts"
      ],
      "adapters/jwt": [
        "./dist/types/adapters/jwt/index.d.ts"
      ],
      "errors": [
        "./dist/types/errors/index.d.ts"
      ],
      "setup": [
        "./dist/types/setup.d.ts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@comity/application": "workspace:*",
    "@comity/core": "workspace:*",
    "@comity/logger": "workspace:*",
    "hono": "^4.11.3",
    "jose": "^6.1.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "typescript": "^5.9.3"
  }
}
